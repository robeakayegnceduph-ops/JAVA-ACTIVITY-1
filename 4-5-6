public class Pyramind { 
    public static void main(String[] args) {
        int column = 7; 
        int rows = 7;   

        for (int i = 0; i < rows; i++) {
            
            for (int j = 0; j < rows - i - 1; j++) {
                System.out.print(" ");
            }
            
            for (int k = 0; k <= i; k++) {
                System.out.print(" * ");
            }
    
            System.out.println();
        }
    }
}
