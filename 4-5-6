public class InvertedRightAngleTriangle { 
    public static void main(String[] args) { 
        int rows = 6; 
        int column = 5; 
        
        for (int i = rows; i >= 1; i--) { 

            int starsToPrint = (i > column) ? column : i; 
            
            for (int j = 1; j <= starsToPrint; j++) { 
                System.out.print(" * "); 
            } 
            System.out.println(); 
        } 
    } 
}

